# =============================================================================
# Catálogo de Monitoramento - monitoring-data/catalogo/catalogo.env
# Lê só a configuração do Zabbix. Use um usuário SOMENTE LEITURA no banco do Zabbix.
# BASE_PATH (/catalogo) e o horário da coleta (CATALOGO_COLLECT_AT) vêm do docker-compose.yml/.env.
# =============================================================================
ZBX_DB_HOST=DBxxx
ZBX_DB_PORT=5432
ZBX_DB_NAME=zabbix
ZBX_DB_USER=zbx_catalogo
ZBX_DB_PASSWORD=ALTERAR_senha_do_zbx_catalogo
ZBX_DB_SSLMODE=prefer
ZBX_DB_STATEMENT_TIMEOUT=600

# Links "abrir no Zabbix"
ZBX_FRONTEND_URL=https://zabbix.empresa.com.br

COLLECT_ON_START=true
# Token para disparar coleta manual (POST /catalogo/api/admin/collect, header X-Admin-Token)
ADMIN_TOKEN=
# Autenticação básica opcional
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

APP_TITLE=Catálogo de Monitoramento
DEMO_MODE=false
