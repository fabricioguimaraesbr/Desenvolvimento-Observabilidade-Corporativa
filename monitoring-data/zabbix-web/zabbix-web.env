# =============================================================================
# Zabbix web (nginx) - monitoring-data/zabbix-web/zabbix-web.env
# Mesmo arquivo nos 3 servidores.
#
# NÃO defina ZBX_SERVER_HOST: em HA o frontend descobre o nó ativo pelo banco.
# =============================================================================

# ---- PostgreSQL do Zabbix 8.0 (já existente) no servidor DBxxx
DB_SERVER_HOST=DBxxx
DB_SERVER_PORT=5432
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
# senha: variável ZBX_DB_PASSWORD da stack no Portainer
DB_SERVER_SCHEMA=public

# ---- ClickHouse no servidor DBxxx (telas de APM)
ZBX_TELEMETRYPROVIDER_0={"provider":"clickhouse","url":"http://DBxxx:8123","db":"zabbix"}
ZBX_TELEMETRYPROVIDER_0_USERNAME=zabbix
# senha: variável CLICKHOUSE_PASSWORD da stack no Portainer

# ---- Interface
ZBX_SERVER_NAME=Zabbix HML-Corp
PHP_TZ=America/Sao_Paulo
# O F5 fica na frente: confie no IP real enviado por ele (ajuste para a rede do F5)
# WEB_REAL_IP_FROM=10.0.0.0/8
# WEB_REAL_IP_HEADER=X-Forwarded-For

# ---- Sessões e limites do PHP
ZBX_MAXEXECUTIONTIME=600
ZBX_MEMORYLIMIT=512M
ZBX_POSTMAXSIZE=16M
ZBX_UPLOADMAXFILESIZE=2M
