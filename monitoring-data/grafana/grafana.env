# =============================================================================
# Grafana - monitoring-data/grafana/grafana.env
# Mesmo arquivo nos 3 servidores: banco compartilhado no PostgreSQL do DBxxx,
# para os 3 mostrarem os mesmos dashboards atrás do F5.
# =============================================================================

# ---- Banco do Grafana (database "grafana" no PostgreSQL do DBxxx)
GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=DBxxx:5432
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=grafana
# senha: variável GRAFANA_DB_PASSWORD da stack no Portainer
GF_DATABASE_SSL_MODE=disable

# ---- Endereço público e segurança
GF_SERVER_ROOT_URL=https://grafana.empresa.com.br/
GF_SECURITY_ADMIN_USER=admin
# senha: variável GRAFANA_ADMIN_PASSWORD da stack no Portainer
# Precisa ser IGUAL nos 3 servidores (criptografa senhas de datasources no banco).
# Gere uma vez com: openssl rand -hex 32
# chave secreta: variável GRAFANA_SECRET_KEY da stack no Portainer (igual nos 3)
GF_USERS_ALLOW_SIGN_UP=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false

# ---- Plugin do Zabbix e datasource provisionado (config/grafana/provisioning)
GF_PLUGINS_PREINSTALL=alexanderzobnin-zabbix-app
# Token de API de um usuário de serviço do Zabbix (somente leitura), criado no frontend
# token: variável ZABBIX_API_TOKEN da stack no Portainer

# ---- HA do alerting: peers vêm das variáveis da stack no Portainer (GRAFANA_HA_PEERS)
GF_UNIFIED_ALERTING_ENABLED=true
