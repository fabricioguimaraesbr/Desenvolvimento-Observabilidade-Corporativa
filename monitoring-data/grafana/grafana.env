# =============================================================================
# Grafana - monitoring-data/grafana/grafana.env
# Mesmo arquivo nos 3 servidores: banco compartilhado no PostgreSQL do DBxxx,
# para os 3 mostrarem os mesmos dashboards atrás do F5.
# =============================================================================

# ---- Banco do Grafana (database "grafana" no PostgreSQL do DBxxx)
GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=DBxxx:5432
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=grafana
# senha: variável GRAFANA_DB_PASSWORD da stack no Portainer
GF_DATABASE_SSL_MODE=disable

# ---- Endereço público e segurança
GF_SERVER_ROOT_URL=https://grafana.empresa.com.br/
GF_SECURITY_ADMIN_USER=admin
# senha: variável GRAFANA_ADMIN_PASSWORD da stack no Portainer
# Precisa ser IGUAL nos 3 servidores (criptografa senhas de datasources no banco).
# Gere uma vez com: openssl rand -hex 32
# chave secreta: variável GRAFANA_SECRET_KEY da stack no Portainer (igual nos 3)
GF_USERS_ALLOW_SIGN_UP=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false

# ---- Plugin do Zabbix: instalado na imagem (versão em config/grafana/Dockerfile);
# datasource provisionado em config/grafana/provisioning
# Token de API de um usuário de serviço do Zabbix (somente leitura), criado no frontend
# token: variável ZABBIX_API_TOKEN da stack no Portainer

# ---- LDAP / Active Directory (arquivo em config/grafana/ldap.toml)
GF_AUTH_LDAP_ENABLED=true
GF_AUTH_LDAP_CONFIG_FILE=/etc/grafana/ldap.toml
# Cria no Grafana o usuário que logar pela primeira vez via LDAP
GF_AUTH_LDAP_ALLOW_SIGN_UP=true
# Esconde o formulário de usuário/senha local? Deixe false para o admin local continuar entrando.
GF_AUTH_DISABLE_LOGIN_FORM=false

# Servidor: vários DCs separados por espaço. LDAPS = 636 + USE_SSL=true;
# LDAP simples = 389 + USE_SSL=false (com START_TLS=true, se o AD aceitar).
LDAP_HOST=dc01.empresa.com.br dc02.empresa.com.br
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_START_TLS=false
# true só para teste: ignora o certificado do AD
LDAP_SSL_SKIP_VERIFY=false
# CA da empresa (vazio = CAs do sistema). Ver config/grafana/certs/LEIA-ME.txt
LDAP_ROOT_CA_CERT=

# Conta de serviço que consulta o AD (a senha é LDAP_BIND_PASSWORD no Portainer)
LDAP_BIND_DN=CN=svc-grafana,OU=Contas de Servico,DC=empresa,DC=com,DC=br

# Onde e como procurar os usuários
LDAP_SEARCH_BASE_DN=DC=empresa,DC=com,DC=br
LDAP_SEARCH_FILTER=(sAMAccountName=%s)

# Grupos do AD -> papéis. Use o DN completo do grupo; "*" = todos os usuários.
LDAP_GROUP_ADMIN_DN=CN=GRP-Grafana-Admin,OU=Grupos,DC=empresa,DC=com,DC=br
LDAP_GROUP_EDITOR_DN=CN=GRP-Grafana-Editor,OU=Grupos,DC=empresa,DC=com,DC=br
# Quem não está nos grupos acima entra como Viewer. Para restringir, troque "*"
# pelo DN de um grupo: quem não estiver em nenhum grupo não consegue entrar.
LDAP_GROUP_VIEWER_DN=*

# ---- HA do alerting: peers vêm das variáveis da stack no Portainer (GRAFANA_HA_PEERS)
GF_UNIFIED_ALERTING_ENABLED=true
