# Zabbix web service (relatórios PDF) - /u/monitoring-data/zabbix-web-service/zabbix-web-service.env
# Só o Zabbix server deste servidor chama o web service.
ZBX_ALLOWEDIP=zabbix-server
ZBX_LISTENPORT=10053
ZBX_TIMEOUT=30
# O web service abre o frontend para gerar o PDF; com HTTPS autoassinado, ignore o certificado
# ZBX_IGNOREURLCERTERRORS=1
ZBX_DEBUGLEVEL=3
