# =============================================================================
# Zabbix MCP server - monitoring-data/zabbix-mcp-server/zabbix-mcp-server.env
# O MCP não guarda credenciais: cada requisição envia o token de API do usuário
# (Authorization: Bearer <token>) e as ações aparecem na auditoria em nome dele.
# =============================================================================
ZBX_FRONTEND_URL=http://zabbix-web:8080/api_jsonrpc.php
# Redes que podem usar o MCP (troque pela rede corporativa dos clientes MCP)
ZBX_ALLOWEDIP=127.0.0.1,::1,10.0.0.0/8
ZBX_TIMEOUT=30
ZBX_MAX_RESPONSE_SIZE=64K
# HTTPS no próprio MCP (opcional)
# ZBX_TLSACCEPT=cert
# ZBX_TLSCERTFILE=/var/lib/zabbix/enc/mcp.crt
# ZBX_TLSKEYFILE=/var/lib/zabbix/enc/mcp.key
#
# Política de ferramentas: por padrão a imagem bloqueia item_get, lld_get,
# interface_get, macro_get e history_get. Definir qualquer ZBX_ALLOWTOOL_* ou
# ZBX_DENYTOOL_* substitui essa política inteira. Exemplo, só leitura:
# ZBX_ALLOWTOOL_REGEXP_0=^(host|hostgroup|trigger|problem)_get$
# ZBX_DENYTOOL_REGEXP_1=.*
ZBX_DEBUGLEVEL=3
