# =============================================================================
# Zabbix server (HA) - /u/monitoring-data/zabbix-server/zabbix-server.env
# Mesmo arquivo nos 3 servidores. Nome e endereço do nó (ZBX_HANODENAME,
# ZBX_NODEADDRESS) vêm do .env do servidor, pelo docker-compose.yml.
# Troque tudo que estiver marcado com ALTERAR_.
# =============================================================================

# ---- PostgreSQL (TimescaleDB) no servidor DBxxx
DB_SERVER_HOST=DBxxx
DB_SERVER_PORT=5432
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=ALTERAR_senha_do_usuario_zabbix
DB_SERVER_SCHEMA=public
# O schema é criado com hypertables do TimescaleDB (extensão criada pelo DBA, ver db/)
ENABLE_TIMESCALEDB=true
# TLS com o banco (opcional)
# ZBX_DBTLSCONNECT=required
# ZBX_DBTLSCAFILE=/var/lib/zabbix/ssl/ssl_ca/root-ca.pem

# ---- ClickHouse no servidor DBxxx: dados de APM (traces, métricas e logs OpenTelemetry)
ZBX_TELEMETRYPROVIDER_0={"provider":"clickhouse","url":"http://DBxxx:8123","db":"zabbix"}
ZBX_TELEMETRYPROVIDER_0_USERNAME=zabbix
ZBX_TELEMETRYPROVIDER_0_PASSWORD=ALTERAR_senha_do_clickhouse
ZBX_STARTTELEMETRYQUERYPOLLERS=2

# ---- Componentes da própria stack (nomes dos containers na rede "monitoring")
ZBX_STARTJAVAPOLLERS=5
ZBX_STARTREPORTWRITERS=1
ZBX_STARTBROWSERPOLLERS=2

# ---- Desempenho (ajuste ao tamanho do ambiente)
ZBX_CACHESIZE=1G
ZBX_HISTORYCACHESIZE=512M
ZBX_HISTORYINDEXCACHESIZE=128M
ZBX_TRENDCACHESIZE=256M
ZBX_VALUECACHESIZE=1G
ZBX_STARTPOLLERS=20
ZBX_STARTPOLLERSUNREACHABLE=5
ZBX_STARTTRAPPERS=10
ZBX_STARTPINGERS=5
ZBX_STARTDISCOVERERS=5
ZBX_STARTHTTPPOLLERS=5
ZBX_STARTPREPROCESSORS=8
ZBX_TIMEOUT=10

ZBX_DEBUGLEVEL=3
