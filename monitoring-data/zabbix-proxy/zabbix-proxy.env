# =============================================================================
# Zabbix proxy (SQLite3) - monitoring-data/zabbix-proxy/zabbix-proxy.env
# Mesmo arquivo nos 3 servidores. O nome (proxy-<NODE_NAME>) e a lista dos nós
# do HA (ZBX_HA_NODES) vêm das variáveis da stack no Portainer.
# Os 3 proxies formam um proxy group no frontend (ver README).
# =============================================================================

# 0 = ativo (o proxy procura o server). Com a lista do HA, ele acha o nó ativo sozinho.
ZBX_PROXYMODE=0

# ---- Buffer e frequência de envio
ZBX_PROXYBUFFERMODE=hybrid
ZBX_PROXYMEMORYBUFFERSIZE=256M
ZBX_PROXYOFFLINEBUFFER=24
ZBX_PROXYCONFIGFREQUENCY=10
ZBX_DATASENDERFREQUENCY=1

# ---- Coletor APM (OpenTelemetry OTLP gRPC na porta 4317), gravando no ClickHouse do DBxxx
ZBX_STARTAPMCOLLECTOR=1
ZBX_APMLISTENIP=0.0.0.0
ZBX_APMLISTENPORT=4317
ZBX_TELEMETRYPROVIDER_0={"provider":"clickhouse","url":"http://DBxxx:8123","db":"zabbix"}
ZBX_TELEMETRYPROVIDER_0_USERNAME=zabbix
# senha: variável CLICKHOUSE_PASSWORD da stack no Portainer
ZBX_STARTTELEMETRYQUERYPOLLERS=1

# ---- Coletas
ZBX_STARTPOLLERS=10
ZBX_STARTPOLLERSUNREACHABLE=2
ZBX_STARTTRAPPERS=5
ZBX_STARTPINGERS=2
ZBX_STARTHTTPPOLLERS=2
ZBX_STARTJAVAPOLLERS=3
ZBX_STARTBROWSERPOLLERS=1
ZBX_CACHESIZE=256M
ZBX_TIMEOUT=10

# ---- Criptografia com o server (opcional; exige o arquivo .psk dentro do container)
# ZBX_TLSCONNECT=psk
# ZBX_TLSACCEPT=psk
# ZBX_TLSPSKIDENTITY=proxy-hml-corp
# ZBX_TLSPSKFILE=/var/lib/zabbix/enc/proxy.psk

ZBX_DEBUGLEVEL=3
