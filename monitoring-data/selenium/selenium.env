# Selenium standalone Chrome (browser items do Zabbix) - monitoring-data/selenium/selenium.env
# Sessões simultâneas: acompanhe ZBX_STARTBROWSERPOLLERS do server + proxy deste servidor.
SE_NODE_MAX_SESSIONS=4
SE_NODE_OVERRIDE_MAX_SESSIONS=true
SE_NODE_SESSION_TIMEOUT=300
SE_SESSION_REQUEST_TIMEOUT=300
SE_SESSION_RETRY_INTERVAL=5
# Sem VNC/noVNC (nenhuma porta de tela publicada)
SE_START_VNC=false
SE_START_NO_VNC=false
