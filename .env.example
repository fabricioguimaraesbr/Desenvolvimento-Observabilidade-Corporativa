# =============================================================================
# Monitoramento Corporativo - variáveis do SERVIDOR (uma cópia por servidor)
# -----------------------------------------------------------------------------
# A mesma stack roda nos 3 servidores. Este arquivo guarda só o que muda de um
# servidor para outro. As variáveis de cada container ficam em
# monitoring-data/<container>/<container>.env.
#
#   cp .env.example .env      # na raiz do repositório, em cada servidor
#
# Troque os nomes fictícios: SRVxxx01..03 (servidores) e os IPs 10.0.0.x.
# =============================================================================

# ---- Identidade deste servidor
# Nome do nó no HA do Zabbix (único por servidor) e IP pelo qual os outros
# nós, proxies e o frontend alcançam este Zabbix server.
NODE_NAME=SRVxxx01
NODE_IP=10.0.0.11

# Endereços dos 3 Zabbix server do HA, separados por ";" (mesmo valor nos 3 servidores).
# Usado pelo proxy para encontrar o nó ativo.
ZBX_HA_NODES=10.0.0.11:10051;10.0.0.12:10051;10.0.0.13:10051

# Peers do alerting do Grafana (porta 9094), separados por vírgula (mesmo valor nos 3 servidores)
GRAFANA_HA_PEERS=10.0.0.11:9094,10.0.0.12:9094,10.0.0.13:9094

# Horário da coleta do Catálogo neste servidor. Use horários diferentes nos 3
# (ex.: 03:30, 03:50, 04:10) para não somar carga no banco.
CATALOGO_COLLECT_AT=03:30

# ---- Versões das imagens
ZABBIX_TAG=alpine-trunk
GRAFANA_TAG=13.2.4
PORTAINER_AGENT_TAG=latest
SELENIUM_TAG=latest

# ---- Portas publicadas neste servidor
# Zabbix web (o F5 balanceia entre os 3 servidores; health check em /ping)
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# Zabbix server (agentes ativos, proxies e outros nós do HA)
ZBX_SERVER_PORT=10051
# Zabbix proxy (a 10051 já é do server) e coletor APM/OpenTelemetry (OTLP gRPC)
ZBX_PROXY_PORT=10061
ZBX_PROXY_APM_PORT=4317
# Zabbix MCP server (a 443 já é do web)
MCP_PORT=8444
# Grafana e o HA do alerting dele
GRAFANA_PORT=3000
GRAFANA_HA_PORT=9094
# Portainer agent
PORTAINER_AGENT_PORT=9001
# Acesso direto ao Catálogo (diagnóstico; o acesso normal é por /catalogo/ no Zabbix web)
CATALOGO_PORT=8088
# Interface em que as portas são publicadas (0.0.0.0 = todas)
BIND_IP=0.0.0.0

TZ=America/Sao_Paulo
