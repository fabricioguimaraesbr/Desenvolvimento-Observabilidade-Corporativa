# =============================================================================
# Variáveis DESTE servidor: senhas e o que muda de um servidor para outro
# -----------------------------------------------------------------------------
# Na raiz do repositório, em cada servidor:
#   cp .env.example .env     # COPIE, não renomeie: este modelo fica no Git
# e preencha o .env. O .env está no .gitignore: as senhas não vão para o Git e
# o git pull não sobrescreve o que você preencheu.
# Todo o resto fica no Git, em monitoring-data/<container>/<container>.env.
# =============================================================================

# ---- Deste servidor (muda em cada stack)
NODE_NAME=SRVxxx01
NODE_IP=10.0.0.11
# Horário da coleta do catálogo; use horários diferentes nos 3 (03:30, 03:50, 04:10)
CATALOGO_COLLECT_AT=03:30

# ---- Iguais nos 3 servidores
# Endereços dos 3 Zabbix server do HA, separados por ";"
ZBX_HA_NODES=10.0.0.11:10051;10.0.0.12:10051;10.0.0.13:10051
# Peers do HA do alerting do Grafana, separados por ","
GRAFANA_HA_PEERS=10.0.0.11:9094,10.0.0.12:9094,10.0.0.13:9094

# ---- Senhas (iguais nos 3 servidores)
# Usuário do Zabbix no PostgreSQL (server e web)
ZBX_DB_PASSWORD=
# Usuário do Zabbix no ClickHouse (server, web e proxy)
CLICKHOUSE_PASSWORD=
# Grafana: banco, admin e chave secreta (a chave PRECISA ser igual nos 3).
# A chave NÃO é senha do banco: ela criptografa os segredos que o Grafana guarda
# no banco. Banco do Grafana já em uso: repita a chave dele. Se nunca foi
# definida, é a padrão do Grafana: SW2YcwTIb9zpOOhoPsMm. Banco novo: gere uma
# com "openssl rand -hex 32". Depois de definida, não troque.
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
# Token de API do Zabbix para o datasource do Grafana (criado depois da 1ª subida)
ZABBIX_API_TOKEN=
# Senha da conta de serviço do LDAP/AD usada pelo Grafana (LDAP_BIND_DN no grafana.env)
LDAP_BIND_PASSWORD=
# Usuário somente leitura do catálogo no banco do Zabbix
CATALOGO_DB_PASSWORD=
# Opcionais do catálogo: coleta manual e autenticação básica
CATALOGO_ADMIN_TOKEN=
CATALOGO_BASIC_AUTH_PASSWORD=

# ---- Opcionais (já têm padrão no docker-compose.yml)
# ZABBIX_TAG=alpine-trunk
# GRAFANA_TAG=13.2.4
# SELENIUM_TAG=latest
# WEB_HTTP_PORT=80
# ZBX_SERVER_PORT=10051
# ZBX_PROXY_PORT=10061
# ZBX_PROXY_APM_PORT=4317
# MCP_PORT=8444
# GRAFANA_PORT=3000
# GRAFANA_HA_PORT=9094
# CATALOGO_PORT=8088
# BIND_IP=0.0.0.0
# TZ=America/Sao_Paulo
