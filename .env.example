# ---- Banco do Zabbix (PostgreSQL/TimescaleDB). Use um usuário SOMENTE LEITURA.
# Se tiver réplica de leitura, aponte para ela.
ZBX_DB_HOST=postgres-server
ZBX_DB_PORT=5432
ZBX_DB_NAME=zabbix
ZBX_DB_USER=zbx_catalogo
ZBX_DB_PASSWORD=troque-esta-senha
ZBX_DB_SSLMODE=prefer
# Tempo máximo por consulta, em segundos
ZBX_DB_STATEMENT_TIMEOUT=600

# ---- Redes docker (docker network ls)
# Onde está o PostgreSQL do Zabbix
ZABBIX_DOCKER_NETWORK=zabbix_default
# Onde está o container zabbix-web (nginx). Se for a mesma rede do banco, repita o valor.
ZABBIX_WEB_DOCKER_NETWORK=zabbix_default
# Porta para acesso direto (diagnóstico). O acesso oficial é https://zabbix.empresa.com.br/catalogo/
CATALOGO_PORT=8088

# ---- Publicação atrás do nginx do Zabbix
# Prefixo público do catálogo. O nginx remove o prefixo antes de repassar;
# o valor aqui é usado pela documentação da API (/catalogo/api/docs).
BASE_PATH=/catalogo

# ---- Frontend do Zabbix (só para os links "abrir no Zabbix")
ZBX_FRONTEND_URL=https://zabbix.empresa.com.br

# ---- Agenda da coleta
# Ou um horário fixo diário (HH:MM, fuso do container)...
COLLECT_AT=03:30
# ...ou, se COLLECT_AT estiver vazio, um intervalo em minutos
COLLECT_INTERVAL_MINUTES=360
# Coleta ao iniciar o container
COLLECT_ON_START=true

# ---- Acesso
# Token para disparar coleta manual: curl -X POST -H "X-Admin-Token: ..." https://zabbix.empresa.com.br/catalogo/api/admin/collect
ADMIN_TOKEN=
# Autenticação básica opcional (deixe vazio para desativar)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

APP_TITLE=Catálogo de Monitoramento
DEMO_MODE=false
TZ=America/Sao_Paulo
