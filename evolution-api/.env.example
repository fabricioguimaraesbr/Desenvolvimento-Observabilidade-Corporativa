# =============================================================================
# Evolution API - variáveis de ambiente
# -----------------------------------------------------------------------------
# 1. Copie este arquivo:  cp .env.example .env
# 2. Substitua tudo que estiver marcado com ALTERAR_
# 3. NUNCA versione o arquivo .env (ele já está no .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Docker / Imagens
# -----------------------------------------------------------------------------
EVOLUTION_IMAGE_TAG=v2.3.7
REDIS_IMAGE_TAG=7-alpine
POSTGRES_IMAGE_TAG=15-alpine
MANAGER_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Portas no HOST
# A 8080 do host já é usada pelos ABX, por isso o padrão é 8081.
# Use API_BIND_IP=127.0.0.1 se a API ficar atrás de um proxy reverso no mesmo host.
# -----------------------------------------------------------------------------
API_BIND_IP=0.0.0.0
API_HOST_PORT=8081
MANAGER_BIND_IP=0.0.0.0
MANAGER_HOST_PORT=3001

# -----------------------------------------------------------------------------
# Servidor
# SERVER_URL = endereço pelo qual a API é acessada de FORA (usado em webhooks,
# QR code e links de mídia). Ex.: https://evolution.empresa.com.br
#                                 http://10.0.0.50:8081
# -----------------------------------------------------------------------------
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_URL=ALTERAR_https://evolution.suaempresa.com.br

# -----------------------------------------------------------------------------
# Autenticação
# Gere uma chave forte:  openssl rand -hex 32
# -----------------------------------------------------------------------------
AUTHENTICATION_API_KEY=ALTERAR_gere_com_openssl_rand_hex_32
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
LANGUAGE=pt-BR

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
#
# >> Produção - Postgres CORPORATIVO (recomendado)
#    Use database e usuário DEDICADOS (ver sql/01-create-evolution-db.sql).
#    Formato:
#    postgresql://USUARIO:SENHA@HOST:PORTA/DATABASE?schema=evolution_api
#    - Se o Postgres exigir SSL, acrescente:  &sslmode=require
#    - Se o Postgres estiver no MESMO servidor do Docker, use como HOST:
#      host.docker.internal
#    - Caracteres especiais na senha (@ : / # ? %) precisam ser codificados
#      em URL (ex.: @ -> %40).
#
# >> Testes - Postgres em container (docker compose --profile local-db up -d)
#    DATABASE_CONNECTION_URI=postgresql://evolution_user:troque_esta_senha@postgres:5432/evolution?schema=evolution_api
# -----------------------------------------------------------------------------
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution_user:ALTERAR_SENHA@ALTERAR_HOST_POSTGRES:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_api

# O que persistir no banco
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# Usado apenas com --profile local-db (Postgres em container)
LOCAL_DB_NAME=evolution
LOCAL_DB_USER=evolution_user
LOCAL_DB_PASSWORD=troque_esta_senha

# -----------------------------------------------------------------------------
# Cache (Redis)
# Padrão: Redis em container (serviço "redis"). Para Redis corporativo, troque
# a URI: redis://:SENHA@HOST:6379/6
# -----------------------------------------------------------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false
REDIS_MAXMEMORY=512mb

# -----------------------------------------------------------------------------
# CORS
# Em produção restrinja às origens que consomem a API.
# -----------------------------------------------------------------------------
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_LEVEL=ERROR,WARN,INFO,LOG,WEBHOOKS
LOG_COLOR=false
LOG_BAILEYS=error

# -----------------------------------------------------------------------------
# Instâncias / sessão
# -----------------------------------------------------------------------------
DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
QRCODE_COLOR='#175197'
EVENT_EMITTER_MAX_LISTENERS=50

# -----------------------------------------------------------------------------
# Telemetria / Sentry / Prometheus
# -----------------------------------------------------------------------------
TELEMETRY_ENABLED=false
TELEMETRY_URL=
SENTRY_DSN=
PROMETHEUS_METRICS=false
METRICS_AUTH_REQUIRED=true
METRICS_USER=prometheus
METRICS_PASSWORD=ALTERAR_senha_metrics
METRICS_ALLOWED_IPS=127.0.0.1

# -----------------------------------------------------------------------------
# Proxy de saída (preencha se a rede corporativa exigir proxy para a internet)
# -----------------------------------------------------------------------------
PROXY_HOST=
PROXY_PORT=
PROXY_PROTOCOL=
PROXY_USERNAME=
PROXY_PASSWORD=

# -----------------------------------------------------------------------------
# Webhook global (opcional - envia eventos de todas as instâncias para uma URL)
# -----------------------------------------------------------------------------
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_APPLICATION_STARTUP=false
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_SET=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_EDITED=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_MESSAGES_DELETE=true
WEBHOOK_EVENTS_SEND_MESSAGE=true
WEBHOOK_EVENTS_SEND_MESSAGE_UPDATE=true
WEBHOOK_EVENTS_CONTACTS_SET=true
WEBHOOK_EVENTS_CONTACTS_UPSERT=true
WEBHOOK_EVENTS_CONTACTS_UPDATE=true
WEBHOOK_EVENTS_PRESENCE_UPDATE=true
WEBHOOK_EVENTS_CHATS_SET=true
WEBHOOK_EVENTS_CHATS_UPSERT=true
WEBHOOK_EVENTS_CHATS_UPDATE=true
WEBHOOK_EVENTS_CHATS_DELETE=true
WEBHOOK_EVENTS_GROUPS_UPSERT=true
WEBHOOK_EVENTS_GROUPS_UPDATE=true
WEBHOOK_EVENTS_GROUP_PARTICIPANTS_UPDATE=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_REMOVE_INSTANCE=false
WEBHOOK_EVENTS_LOGOUT_INSTANCE=false
WEBHOOK_EVENTS_LABELS_EDIT=true
WEBHOOK_EVENTS_LABELS_ASSOCIATION=true
WEBHOOK_EVENTS_CALL=true
WEBHOOK_EVENTS_TYPEBOT_START=false
WEBHOOK_EVENTS_TYPEBOT_CHANGE_STATUS=false
WEBHOOK_EVENTS_ERRORS=false
WEBHOOK_EVENTS_ERRORS_WEBHOOK=
WEBHOOK_REQUEST_TIMEOUT_MS=60000
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=300
WEBHOOK_RETRY_JITTER_FACTOR=0.2
WEBHOOK_RETRY_NON_RETRYABLE_STATUS_CODES=400,401,403,404,422

# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false
WEBSOCKET_ALLOWED_HOSTS=127.0.0.1,::1,::ffff:127.0.0.1

# -----------------------------------------------------------------------------
# Filas / mensageria (desativadas - habilite conforme a necessidade)
# -----------------------------------------------------------------------------
RABBITMQ_ENABLED=false
RABBITMQ_URI=amqp://usuario:senha@rabbitmq:5672
RABBITMQ_EXCHANGE_NAME=evolution
RABBITMQ_GLOBAL_ENABLED=false
RABBITMQ_PREFIX_KEY=evolution

SQS_ENABLED=false
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=
SQS_ACCOUNT_ID=
SQS_REGION=

KAFKA_ENABLED=false
KAFKA_CLIENT_ID=evolution-api
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_PREFIX=evolution
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_ENABLED=false

PUSHER_ENABLED=false

# -----------------------------------------------------------------------------
# Armazenamento de mídia em S3 / MinIO (opcional)
# -----------------------------------------------------------------------------
S3_ENABLED=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=evolution
S3_PORT=443
S3_ENDPOINT=s3.suaempresa.com.br
S3_REGION=us-east-1
S3_USE_SSL=true

# -----------------------------------------------------------------------------
# WhatsApp Business API oficial (Cloud API - Meta)
# -----------------------------------------------------------------------------
WA_BUSINESS_TOKEN_WEBHOOK=ALTERAR_token_webhook_meta
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_VERSION=v20.0
WA_BUSINESS_LANGUAGE=pt_BR

# -----------------------------------------------------------------------------
# Integrações (desativadas)
# -----------------------------------------------------------------------------
TYPEBOT_ENABLED=false
TYPEBOT_API_VERSION=latest
CHATWOOT_ENABLED=false
CHATWOOT_MESSAGE_READ=true
CHATWOOT_MESSAGE_DELETE=true
CHATWOOT_BOT_CONTACT=true
CHATWOOT_IMPORT_DATABASE_CONNECTION_URI=
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=true
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
